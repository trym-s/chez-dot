#!/bin/sh

view="icon"
[ "$1" = "--view" ] && view="${2:-icon}"

load_avg="$(cut -d' ' -f1 /proc/loadavg)"
cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')"

scaled="$(awk -v avg="$load_avg" -v cores="$cores" 'BEGIN {
  if (cores < 1) cores = 1
  pct = avg / cores
  if (pct < .20) print "___"; else if (pct < .40) print "_-_"; else if (pct < .65) print "-=-"; else if (pct < .90) print "=+="; else print "###"
}')"
class="$(awk -v avg="$load_avg" -v cores="$cores" 'BEGIN {
  pct = avg / cores
  if (pct >= .90) print "hot"; else if (pct >= .65) print "warm"; else print "cool"
}')"

if [ "$view" = "text" ]; then
  text="CPU ${load_avg}"
else
  text=" ${scaled} ${load_avg}"
fi

printf '{"text":"%s","tooltip":"load average: %s on %s cores","class":"%s"}\n' "$text" "$load_avg" "$cores" "$class"
