#!/bin/sh

view="icon"
[ "$1" = "--view" ] && view="${2:-icon}"

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
[ -w "$state_dir" ] || state_dir="/tmp"
state_file="$state_dir/waybar-network.state"

iface="$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
if [ -z "$iface" ]; then
  for path in /sys/class/net/*; do
    name="${path##*/}"
    [ "$name" = "lo" ] && continue
    [ "$(cat "$path/operstate" 2>/dev/null)" = "up" ] && { iface="$name"; break; }
  done
fi

if [ -z "$iface" ] || [ ! -r "/sys/class/net/$iface/statistics/rx_bytes" ]; then
  [ "$view" = "text" ] && text="NET off" || text="󰤮 off"
  printf '{"text":"%s","tooltip":"network disconnected","class":"offline"}\n' "$text"
  exit 0
fi

rx="$(cat "/sys/class/net/$iface/statistics/rx_bytes")"
tx="$(cat "/sys/class/net/$iface/statistics/tx_bytes")"
now="$(date +%s)"

old_iface=""
old_rx="$rx"
old_tx="$tx"
old_now="$now"
[ -r "$state_file" ] && read -r old_iface old_rx old_tx old_now < "$state_file"
printf '%s %s %s %s\n' "$iface" "$rx" "$tx" "$now" > "$state_file"

elapsed=$((now - old_now))
[ "$elapsed" -lt 1 ] && elapsed=1

if [ "$old_iface" = "$iface" ]; then
  down=$(((rx - old_rx) / elapsed))
  up=$(((tx - old_tx) / elapsed))
else
  down=0
  up=0
fi

fmt_rate() {
  awk -v b="$1" 'BEGIN {
    if (b >= 1048576) printf "%.1fM", b / 1048576
    else if (b >= 1024) printf "%.0fK", b / 1024
    else printf "%dB", b
  }'
}

ssid="$(iwgetid -r "$iface" 2>/dev/null)"
if [ -n "$ssid" ]; then
  icon="󰤨"
  name="$ssid"
else
  icon="󰈀"
  name="$iface"
fi

if [ "$view" = "text" ]; then
  text="NET ${name} D$(fmt_rate "$down") U$(fmt_rate "$up")"
else
  text="${icon} ${name} ↓$(fmt_rate "$down") ↑$(fmt_rate "$up")"
fi

printf '{"text":"%s","tooltip":"%s via %s","class":"online"}\n' "$text" "$name" "$iface"
