{{- $profileName := "default" -}}
{{- if hasKey . "host_profile" -}}{{- $profileName = .host_profile -}}{{- end -}}
{{- if not (hasKey .host_profiles $profileName) -}}{{- $profileName = "default" -}}{{- end -}}
{{- $profile := index .host_profiles $profileName -}}
{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
{{- if not (hasKey $theme "bg") -}}{{- $themeName = "rose" -}}{{- $theme = index .themes $themeName -}}{{- end -}}
{{- $hostIcon := "" -}}
{{- $hostLabel := "#H" -}}
{{- $hostAccent := $theme.term_accent -}}
{{- if hasKey $profile "machine" -}}
{{- $hostIcon = $profile.machine.icon -}}
{{- $hostLabel = $profile.machine.label -}}
{{- $hostAccent = $profile.machine.accent -}}
{{- end -}}
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB"
set -g focus-events on
set -g escape-time 0
set -g history-limit 50000
set -g mouse on
set -g renumber-windows on
set -g base-index 1
setw -g pane-base-index 0
setw -g mode-keys vi
set -g detach-on-destroy off
set -g display-time 1200
set -g status-keys vi

unbind C-b
set -g prefix C-a
bind C-a send-prefix

bind r source-file ~/.tmux.conf \; display-message "tmux config reloaded"
bind c new-window -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"

bind-key -n M-c new-window -c "#{pane_current_path}"
bind-key -n M-x kill-pane
bind-key -n M-v split-window -h -c "#{pane_current_path}"
bind-key -n M-h split-window -v -c "#{pane_current_path}"

# Workspaces are tmux windows: Alt+1..9/0 switches the full-window workspace.
bind-key -n M-1 select-window -t:=1
bind-key -n M-2 select-window -t:=2
bind-key -n M-3 select-window -t:=3
bind-key -n M-4 select-window -t:=4
bind-key -n M-5 select-window -t:=5
bind-key -n M-6 select-window -t:=6
bind-key -n M-7 select-window -t:=7
bind-key -n M-8 select-window -t:=8
bind-key -n M-9 select-window -t:=9
bind-key -n M-0 select-window -t:=10

# Panes live inside the current workspace: Alt+arrows moves focus between them.
bind-key -n M-Left  select-pane -L
bind-key -n M-Right select-pane -R
bind-key -n M-Up    select-pane -U
bind-key -n M-Down  select-pane -D

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r H resize-pane -L 5
bind -r J resize-pane -D 3
bind -r K resize-pane -U 3
bind -r L resize-pane -R 5

bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi y send -X copy-pipe-and-cancel "wl-copy"
bind-key -T copy-mode-vi Escape send -X cancel
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-no-clear "wl-copy"

set -g status on
set -g status-interval 5
set -g status-position top
set -g status-style "bg=#{{ $theme.bg }},fg=#{{ $theme.fg }}"
set -g status-left-length 48
set -g status-right-length 32
set -g status-left "#[bg=colour{{ $hostAccent }},fg=colour{{ $theme.term_fg }},bold] {{ if $hostIcon }}{{ $hostIcon }} {{ end }}{{ $hostLabel }} #[bg=#{{ $theme.bg }},fg=colour{{ $hostAccent }}] #[bg=#{{ $theme.bg }},fg=#{{ $theme.subtle }}] #S "
set -g status-right "#[fg=#{{ $theme.muted }}]󰖲 #{session_windows} #[fg=#{{ $theme.surface_alt }}]| #[fg=#{{ $theme.subtle }}]󰍹 #{session_attached} "
set -g window-status-separator ""
set -g window-status-format "#[bg=#{{ $theme.bg }},fg=#{{ $theme.muted }}] #I #[fg=#{{ $theme.subtle }}]#W "
set -g window-status-current-format "#[bg=colour{{ $hostAccent }},fg=colour15,bold] #I #W#{?#{==:#{pane_current_command},ssh}, #[bg=colour197,fg=colour15,bold]VPS#[bg=colour{{ $hostAccent }},fg=colour15,bold],#{?#{m:*/mnt/vps*,#{pane_current_path}}, #[fg=colour221]LOCAL#[fg=colour15],}} "
set -g pane-border-style "fg=#{{ $theme.surface }}"
set -g pane-active-border-style "fg=colour{{ $hostAccent }}"
set -g pane-border-indicators off
set -g pane-border-lines simple
set -g window-style "bg=default"
set -g window-active-style "bg=default"
set -g pane-border-status top
set -g pane-border-format "#{?pane_active,#{?#{==:#{pane_current_command},ssh},#[bg=colour197,fg=colour15,bold] VPS #[bg=default,fg=#{{ $theme.muted }}]ssh,#{?#{m:*/mnt/vps*,#{pane_current_path}},#[fg=colour221,bold] LOCAL #[fg=#{{ $theme.muted }}]sshfs,#[fg=colour{{ $hostAccent }},bold] #{pane_current_command} }},#[fg=#{{ $theme.muted }}] #{pane_current_command} }"
set -g display-panes-colour "#{{ $theme.muted }}"
set -g display-panes-active-colour "colour{{ $hostAccent }}"
set -g message-style "bg=#{{ $theme.surface }},fg=#{{ $theme.white }}"
set -g message-command-style "bg=#{{ $theme.bg }},fg=colour{{ $hostAccent }}"
set -g mode-style "bg=colour{{ $hostAccent }},fg=colour{{ $theme.term_fg }}"
set -g default-terminal "tmux-256color"
set -g update-environment "DISPLAY SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY LANG LC_ALL LC_CTYPE"
