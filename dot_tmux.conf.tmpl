{{- $profileName := "default" -}}
{{- if hasKey . "host_profile" -}}{{- $profileName = .host_profile -}}{{- end -}}
{{- if not (hasKey .host_profiles $profileName) -}}{{- $profileName = "default" -}}{{- end -}}
{{- $profile := index .host_profiles $profileName -}}
{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
{{- if not (hasKey $theme "bg") -}}{{- $themeName = "rose" -}}{{- $theme = index .themes $themeName -}}{{- end -}}
{{- $hostIcon := "" -}}
{{- $hostLabel := "#H" -}}
{{- $hostAccent := $theme.term_accent -}}
{{- if hasKey $profile "machine" -}}
{{- $hostIcon = $profile.machine.icon -}}
{{- $hostLabel = $profile.machine.label -}}
{{- end -}}
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB"
set -g focus-events on
set -g escape-time 0
set -g history-limit 50000
# Yazi/image-preview: let apps talk to the terminal through tmux (fixes TRT timeout)
set -g allow-passthrough on
set -g mouse on
set -g renumber-windows on
set -g base-index 1
setw -g pane-base-index 0
setw -g mode-keys vi
set -g detach-on-destroy off
set -g display-time 1200
set -g status-keys vi

unbind C-b
set -g prefix C-a
bind C-a send-prefix

bind [ copy-mode

unbind-key -q Tab
unbind-key -q ,
unbind-key -q 0
unbind-key -q g
unbind-key -q G
unbind-key -q k
unbind-key -q m
unbind-key -q o
unbind-key -q x
unbind-key -q &
unbind-key -q -n M-[
unbind-key -q -n M-]
unbind-key -q -n M-`
unbind-key -q -n M-~
unbind-key -q -n "M-{"
unbind-key -q -n "M-}"
unbind-key -q -n M-n
unbind-key -q -n M-N
unbind-key -q -n M-S-m
unbind-key -q -n M-S-n
unbind-key -q -n M-S-w
unbind-key -q -T root MouseDown2Status
unbind-key -q -T root MouseDown3Status
unbind-key -q -T root MouseDown3Border
unbind-key -q -T copy-mode MouseDragEnd1Pane
unbind-key -q -T copy-mode-vi MouseDragEnd1Pane

bind r source-file ~/.tmux.conf \; display-message "tmux config reloaded"
bind c new-window -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"
bind , command-prompt -I "#W" "rename-window '%%'"
bind x confirm-before -p "kill-pane #P? (y/n)" kill-pane
bind & confirm-before -p "kill-window #W? (y/n)" kill-window

bind-key -n M-c new-window -c "#{pane_current_path}"
bind-key -n M-x kill-pane
bind-key -n M-v split-window -h -c "#{pane_current_path}"
bind-key -n M-h split-window -v -c "#{pane_current_path}"
# M-[ / M-] collide with the CSI introducer (ESC [), which made Yazi's DA1/DSR
# query responses trigger window switches. Use M-, / M-. instead.
bind-key -n M-, previous-window
bind-key -n M-. next-window

# Workspaces are tmux windows: Alt+1..9/0 switches the full-window workspace.
bind-key -n M-1 select-window -t:=1
bind-key -n M-2 select-window -t:=2
bind-key -n M-3 select-window -t:=3
bind-key -n M-4 select-window -t:=4
bind-key -n M-5 select-window -t:=5
bind-key -n M-6 select-window -t:=6
bind-key -n M-7 select-window -t:=7
bind-key -n M-8 select-window -t:=8
bind-key -n M-9 select-window -t:=9
bind-key -n M-0 select-window -t:=10

# Panes live inside the current workspace: Alt+arrows moves focus between them.
bind-key -n M-Left  select-pane -L
bind-key -n M-Right select-pane -R
bind-key -n M-Up    select-pane -U
bind-key -n M-Down  select-pane -D

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r H resize-pane -L 5
bind -r J resize-pane -D 3
bind -r K resize-pane -U 3
bind -r L resize-pane -R 5

bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi y send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi Enter send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi Escape send -X cancel
bind-key -T root MouseDrag1Pane if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -M"
bind-key -T root WheelUpPane if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -e"
bind-key -T root WheelDownPane if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "send-keys -M"
bind-key -T copy-mode MouseDragEnd1Pane send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi C-j send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi DoubleClick1Pane select-pane \; send -X select-word \; send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection
bind-key -T copy-mode-vi TripleClick1Pane select-pane \; send -X select-line \; send -X copy-pipe-no-clear "wl-copy" \; send -X clear-selection

set -g status on
set -g status-interval 5
set -g status-position top
set -g status-style "bg=#{{ $theme.bg }},fg=#{{ $theme.fg }}"
set -g status-left-length 48
set -g status-right-length 32
set -g status-left "#[bg=colour{{ $hostAccent }},fg=#{{ $theme.bg }},bold] {{ if $hostIcon }}{{ $hostIcon }} {{ end }}{{ $hostLabel }} #[bg=#{{ $theme.bg }},fg=colour{{ $hostAccent }}] #[bg=#{{ $theme.bg }},fg=#{{ $theme.subtle }}] #S "
set -g status-right "#[fg=#{{ $theme.muted }}]󰖲 #{session_windows} #[fg=#{{ $theme.surface_alt }}]| #[fg=#{{ $theme.subtle }}]󰍹 #{session_attached} "
set -g window-status-separator ""
set -g window-status-format "#[bg=#{{ $theme.bg }},fg=#{{ $theme.muted }}] #I #[fg=#{{ $theme.subtle }}]#W "
set -g window-status-current-format "#[bg=colour{{ $hostAccent }},fg=#{{ $theme.bg }},bold] #I #W#{?#{==:#{pane_current_command},ssh}, #[bg=colour197,fg=colour15,bold]VPS#[bg=colour{{ $hostAccent }},fg=#{{ $theme.bg }},bold],#{?#{m:*/mnt/vps*,#{pane_current_path}}, #[fg=colour221]LOCAL#[fg=#{{ $theme.bg }}],}} "
bind-key -T root MouseDown1Status select-window -t =
bind-key -T root MouseDown2Status kill-window -t =
bind-key -T root MouseDown3Status command-prompt -I "#W" "rename-window '%%'"
bind-key -T root MouseDown1StatusRight new-window -c "#{pane_current_path}"
bind-key -T root WheelUpStatus previous-window
bind-key -T root WheelDownStatus next-window
set -g pane-border-style "fg=#{{ $theme.surface_dark }},bg=#{{ $theme.bg }}"
set -g pane-active-border-style "fg=#{{ $theme.accent_alt }},bg=#{{ $theme.bg }},bold"
set -g pane-border-indicators off
set -g pane-border-lines heavy
set -g window-style "bg=default"
set -g window-active-style "bg=default"
set -g pane-border-status top
set -g pane-border-format "#{?pane_active,#[bg=#{{ $theme.surface_alt }},fg=#{{ $theme.accent_alt }},bold] {{ if $hostIcon }}{{ $hostIcon }} {{ end }}{{ $hostLabel }} #[bg=#{{ $theme.surface }},fg=#{{ $theme.fg }},bold] #I:#W #[bg=#{{ $theme.surface_dark }},fg=#{{ $theme.subtle }}] #P #{pane_current_command} #[fg=#{{ $theme.muted }}]#{b:pane_current_path} ,#[bg=#{{ $theme.bg }},fg=#{{ $theme.muted }}] #P #{pane_current_command} #[fg=#{{ $theme.surface_alt }}]#{b:pane_current_path} }"
set -g display-panes-colour "#{{ $theme.muted }}"
set -g display-panes-active-colour "colour{{ $hostAccent }}"
set -g message-style "bg=#{{ $theme.surface }},fg=#{{ $theme.fg }}"
set -g message-command-style "bg=#{{ $theme.bg }},fg=colour{{ $hostAccent }}"
set -g mode-style "bg=colour{{ $hostAccent }},fg=#{{ $theme.bg }},bold"
set -g default-terminal "tmux-256color"
set -g update-environment "DISPLAY SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY LANG LC_ALL LC_CTYPE"
set -g @local_pane_active_bg "default"
set -g @local_pane_inactive_bg "#{{ $theme.surface_dark }}"
set-hook -gu after-kill-pane
set-hook -gu after-new-window
set-hook -gu after-rename-window
set-hook -gu after-resize-pane
set-hook -gu after-resize-window
set-hook -gu after-select-pane
set-hook -gu after-select-window
set-hook -gu after-split-window
set-hook -gu client-active
set-hook -gu client-attached
set-hook -gu client-focus-in
set-hook -gu client-resized
set-hook -gu session-created
set-hook -gu window-linked
set-hook -gu window-unlinked
set-hook -g after-new-window "run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'"
set-hook -g after-select-pane "run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'"
set-hook -g after-select-window "run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'"
set-hook -g after-split-window "run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'"
set-hook -g pane-focus-in "run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'"
run-shell -b '$HOME/.local/bin/tmux-pane-focus-theme'
