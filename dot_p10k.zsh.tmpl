)
typeset -g POWERLEVEL9K_DIR_DEV_VISUAL_IDENTIFIER_EXPANSION='󰲋'
typeset -g POWERLEVEL9K_DIR_DEV_FOREGROUND={{ $theme.dir }}
typeset -g POWERLEVEL9K_DIR_DEV_ANCHOR_FOREGROUND={{ $theme.dir_anchor }}
