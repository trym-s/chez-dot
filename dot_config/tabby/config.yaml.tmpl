{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
{{- if not (hasKey $theme "bg") -}}{{- $themeName = "rose" -}}{{- $theme = index .themes $themeName -}}{{- end -}}
position: top
height: 2

terminal_title:
  enabled: true
  format: "tmux #{window_index}.#{pane_index} #{window_name} #{pane_current_command}"

style:
  rounded: false
  separator_left: ""
  separator_right: ""

overflow:
  mode: scroll
  indicator: ">"

groups:
  - name: "Default"
    pattern: ".*"
    theme:
      bg: "#{{ $theme.surface }}"
      active_bg: "#{{ $theme.surface_alt }}"
      icon: ""
      active_indicator_bg: "#{{ $theme.accent_alt }}"

bindings:
  toggle_sidebar: "prefix + Tab"
  next_tab: "prefix + n"
  prev_tab: "prefix + p"
  next_window_global: "cmd+]"
  prev_window_global: "cmd+["
  new_window_global: "cmd+shift+n"
  kill_window_global: "cmd+shift+w"
  toggle_minimize_window: "cmd+shift+m"
  new_window: "prefix + c"
  kill_pane: "prefix + x"
  split_horizontal: "prefix + \""
  split_vertical: "prefix + %"
  rename_window: "prefix + ,"
  window_list: "prefix + w"
  display_panes: "prefix + q"
  detach: "prefix + d"
  swap_pane: "cmd+`"

sidebar:
  header:
    fg: "#{{ $theme.fg }}"
    bg: "#{{ $theme.bg }}"
    active_color: true
  pane_headers: true
  new_tab_button: false
  new_group_button: false
  show_empty_groups: false
  close_button: false
  sort_by: "index"
  hide_predefined_colors: true
  debug: false
  line_height: 0
  mobile_max_percent: 15
  mobile_min_content_cols: 40
  mobile_max_window_cols: 110
  tablet_max_window_cols: 170
  width_mobile: 15
  width_tablet: 20
  width_desktop: 25
  theme: dark
  colors:
    disclosure_expanded: "-"
    disclosure_collapsed: "+"
    active_indicator_frames: [">", " "]
    tree_branch: "|-"
    tree_branch_last: "`-"
    tree_connector: "-"
    tree_connector_panes: "+"
    tree_continue: "|"

pane_header:
  active_fg: "#{{ $theme.white }}"
  active_bg: "#{{ $theme.surface_alt }}"
  inactive_fg: "#{{ $theme.subtle }}"
  inactive_bg: "#{{ $theme.surface }}"
  command_fg: "#{{ $theme.subtle }}"
  terminal_bg: "#{{ $theme.bg }}"
  border_from_tab: false
  auto_border: false
  dim_inactive: true
  dim_opacity: 0.72
  border_fg: "#{{ $theme.surface_alt }}"
  border_lines: heavy
  custom_border: true
  handle_icon: "..."
  draggable: true
  collapse_expanded_icon: "v"
  collapse_collapsed_icon: ">"
  resize_horizontal_grow_icon: ">"
  resize_horizontal_shrink_icon: "<"
  resize_vertical_grow_icon: "v"
  resize_vertical_shrink_icon: "^"
  resize_separator: "|"

prompt:
  fg: "#{{ $theme.bg }}"
  bg: "#{{ $theme.accent_alt }}"
  bold: true
  shell_integration: true
  fallback_icon: ""

terminal_app: kitty

busy_detection:
  ai_tools:
    - opencode
    - gemini
    - codex
    - aider
    - cursor
    - copilot
    - grok
  idle_timeout: 10

indicators:
  activity:
    enabled: false
    icon: "!"
    color: "#{{ $theme.warning }}"
  bell:
    enabled: true
    icon: "!"
    color: "#{{ $theme.bg }}"
    bg: "#{{ $theme.warning }}"
  silence:
    enabled: true
    icon: "o"
    color: "#{{ $theme.muted }}"
  busy:
    enabled: true
    icon: "*"
    color: "#{{ $theme.warning }}"
    frames: ["*", "+"]
  input:
    enabled: true
    icon: "?"
    color: "#{{ $theme.accent_alt }}"
    frames: ["?", "?"]

widgets:
  clock:
    enabled: false
  stats:
    enabled: false
  pet:
    enabled: false
