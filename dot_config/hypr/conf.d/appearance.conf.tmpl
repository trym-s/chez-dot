{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
{{- $appearanceName := "compact" -}}
{{- if hasKey . "hypr_appearance" -}}{{- $appearanceName = .hypr_appearance -}}{{- end -}}
{{- if not (hasKey .hypr_appearance_profiles $appearanceName) -}}{{- $appearanceName = "compact" -}}{{- end -}}
{{- $appearance := index .hypr_appearance_profiles $appearanceName -}}
general {
    gaps_in             = {{ $appearance.gaps_in }}
    gaps_out            = {{ $appearance.gaps_out }}
    border_size         = {{ $appearance.border_size }}
    col.active_border   = rgb({{ $theme.accent }})
    col.inactive_border = rgb({{ $theme.surface }})
    layout              = dwindle
    allow_tearing       = false
}

decoration {
    rounding = {{ $appearance.rounding }}
    shadow {
        enabled = {{ $appearance.shadow.enabled }}
        range = {{ $appearance.shadow.range }}
        render_power = {{ $appearance.shadow.render_power }}
        color = {{ $appearance.shadow.color }}
    }
    blur {
        enabled = {{ $appearance.blur.enabled }}
        size = {{ $appearance.blur.size }}
        passes = {{ $appearance.blur.passes }}
        vibrancy = {{ $appearance.blur.vibrancy }}
    }
}

animations {
    enabled = {{ $appearance.animations.enabled }}
    bezier = {{ $appearance.animations.bezier }}
    animation = {{ $appearance.animations.windows }}
    animation = {{ $appearance.animations.border }}
    animation = {{ $appearance.animations.fade }}
    animation = {{ $appearance.animations.workspaces }}
}

dwindle {
    preserve_split = true
    smart_split = true
    smart_resizing = true
}

misc {
    disable_hyprland_logo    = true
    disable_splash_rendering = true
    mouse_move_enables_dpms  = true
    key_press_enables_dpms   = true
}
