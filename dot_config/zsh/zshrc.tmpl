export PATH="$HOME/.local/bin:$PATH"

command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lah --group-directories-first --icons=auto'
alias la='eza -la --group-directories-first --icons=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias cat='bat --paging=never'
alias v='nvim'
alias n='nvim'
alias ..='cd ..'
alias ...='cd ../..'
__pacman_clear_stale_lock() {
  local lock=/var/lib/pacman/db.lck

  [[ -e "$lock" ]] || return 0

  if sudo fuser "$lock" >/dev/null 2>&1 || sudo lsof "$lock" >/dev/null 2>&1; then
    echo "pacman database lock is active: $lock" >&2
    echo "Another package manager appears to be running; not removing the lock." >&2
    return 1
  fi

  echo "Removing stale pacman database lock: $lock" >&2
  sudo rm -f "$lock"
}

sp() {
  __pacman_clear_stale_lock || return
  sudo pacman "$@"
}
alias pacup="sp -Syu"
alias cleanup='sudo pacman -Rns $(pacman -Qtdq)'
alias bd='bg && disown'
alias disk='df -B1 --total -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null | awk '\''/^total/{printf "Total: %.2f GB\nUsed:  %.2f GB\nFree:  %.2f GB\n", $2/1073741824, $3/1073741824, $4/1073741824}'\'''

bindkey -e

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source /usr/share/fzf/key-bindings.zsh
command -v fzf >/dev/null && source /usr/share/fzf/completion.zsh

if command -v fzf >/dev/null; then
  __fzf_files() {
    if command -v rg >/dev/null; then
      rg --files --hidden --follow --glob '!.git/*'
    else
      find . -path '*/.git/*' -prune -o -type f -print
    fi
  }

  __fzf_file_preview='file={}; if command -v bat >/dev/null; then bat --style=numbers --color=always --line-range=:200 -- "$file"; else sed -n "1,200p" -- "$file"; fi'

  fzf-open-nvim() {
    local selected
    local -a files

    selected="$(
      __fzf_files |
        fzf --multi --height=80% --layout=reverse --border --cycle \
          --prompt='nvim> ' \
          --preview="$__fzf_file_preview" \
          --preview-window='right,60%,border-left'
    )" || return

    files=("${(f)selected}")
    (( ${#files[@]} )) || return

    zle -I
    command nvim -- "${files[@]}"
    zle reset-prompt
  }
  zle -N fzf-open-nvim
  bindkey '^T' fzf-open-nvim

  fzf-rg-open-nvim() {
    command -v rg >/dev/null || return

    local selected file line

    selected="$(
      rg --line-number --column --hidden --smart-case --glob '!.git/*' --color=never '' |
        fzf --height=80% --layout=reverse --border --cycle \
          --prompt='rg> ' \
          --delimiter=':' \
          --preview='file={1}; line={2}; if command -v bat >/dev/null; then bat --style=numbers --color=always --highlight-line "$line" --line-range "$((line > 8 ? line - 8 : 1)):$((line + 8))" -- "$file"; else sed -n "$((line > 8 ? line - 8 : 1)),$((line + 8))p" -- "$file"; fi' \
          --preview-window='right,60%,border-left'
    )" || return

    file="${selected%%:*}"
    selected="${selected#*:}"
    line="${selected%%:*}"

    [[ -n "$file" && -n "$line" ]] || return

    zle -I
    command nvim +"$line" -- "$file"
    zle reset-prompt
  }
  zle -N fzf-rg-open-nvim
  bindkey '^G' fzf-rg-open-nvim
fi

