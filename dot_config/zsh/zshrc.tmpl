{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
[[ -o interactive ]] || return

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history hist_ignore_dups hist_ignore_space
setopt hist_reduce_blanks inc_append_history
setopt auto_cd auto_pushd pushd_ignore_dups
setopt prompt_subst

autoload -Uz compinit
compinit -d "$HOME/.cache/zcompdump"

zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' verbose yes
bindkey -M menuselect '^[[Z' reverse-menu-complete

[[ -r /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]] && source /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons=auto $realpath 2>/dev/null || ls -1 --color=always $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:*:*' fzf-preview '[[ -f $realpath ]] && (bat --color=always --style=numbers --line-range=:200 -- $realpath 2>/dev/null || cat -- $realpath) || (eza -1 --color=always --icons=auto $realpath 2>/dev/null || ls -1 --color=always $realpath 2>/dev/null)'
zstyle ':fzf-tab:*' switch-group '<' '>'

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R'
export BAT_THEME=TwoDark
export CLICOLOR=1
export COLORTERM=truecolor
export FORCE_COLOR=1
export SYSTEMD_COLORS=1
export GREP_COLORS='ms=01;38;2;255;255;255:mc=01;38;2;255;255;255:sl=:cx=:fn=38;2;95;255;255:ln=38;2;255;209;102:bn=38;2;185;128;255:se=38;2;110;122;145'
export EZA_COLORS='di=38;2;95;255;255:ex=38;2;92;255;176:fi=38;2;234;242;255:ln=38;2;140;200;255:or=38;2;255;77;109:*.md=38;2;92;255;176:*.json=38;2;255;209;102:*.yaml=38;2;215;175;255:*.yml=38;2;215;175;255:*.toml=38;2;215;175;255:*.sh=38;2;92;255;176:*.py=38;2;255;209;102:*.js=38;2;255;209;102:*.ts=38;2;140;200;255'
