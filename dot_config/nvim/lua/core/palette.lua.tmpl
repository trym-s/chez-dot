{{- $themeName := "rose" -}}
{{- if hasKey . "theme" -}}{{- $themeName = .theme -}}{{- end -}}
{{- if and (not (hasKey .themes $themeName)) (hasKey .theme_aliases $themeName) -}}{{- $themeName = index .theme_aliases $themeName -}}{{- end -}}
{{- if not (hasKey .themes $themeName) -}}{{- $themeName = "rose" -}}{{- end -}}
{{- $theme := index .themes $themeName -}}
-- Generated by chezmoi from .chezmoidata.yaml. Do not edit directly.
-- Change theme by editing ~/.config/chezmoi/chezmoi.toml and running: chezmoi apply
return {
  name         = "{{ $themeName }}",
  colorscheme  = "chezmoi-{{ $themeName }}",
  bg           = "#{{ $theme.bg }}",
  fg           = "#{{ $theme.fg }}",
  surface      = "#{{ $theme.surface }}",
  surface_alt  = "#{{ $theme.surface_alt }}",
  surface_dark = "#{{ $theme.surface_dark }}",
  muted        = "#{{ $theme.muted }}",
  subtle       = "#{{ $theme.subtle }}",
  accent       = "#{{ $theme.accent }}",
  accent_alt   = "#{{ $theme.accent_alt }}",
  success      = "#{{ $theme.success_bright }}",
  warning      = "#{{ $theme.warning }}",
  info         = "#{{ $theme.info_bright }}",
  secondary    = "#{{ $theme.secondary_bright }}",
  cyan         = "#{{ $theme.cyan_bright }}",
  danger       = "#{{ $theme.danger }}",
  white        = "#{{ $theme.white }}",

  green        = "#{{ if hasKey $theme "syntax_green" }}{{ $theme.syntax_green }}{{ else }}{{ $theme.success_bright }}{{ end }}",
  yellow       = "#{{ if hasKey $theme "syntax_yellow" }}{{ $theme.syntax_yellow }}{{ else }}{{ $theme.warning }}{{ end }}",
  blue         = "#{{ if hasKey $theme "syntax_blue" }}{{ $theme.syntax_blue }}{{ else }}{{ $theme.info_bright }}{{ end }}",
  magenta      = "#{{ if hasKey $theme "syntax_magenta" }}{{ $theme.syntax_magenta }}{{ else }}{{ $theme.secondary_bright }}{{ end }}",
  red          = "#{{ if hasKey $theme "syntax_red" }}{{ $theme.syntax_red }}{{ else }}{{ $theme.danger }}{{ end }}",
  syntax_cyan  = "#{{ if hasKey $theme "syntax_cyan" }}{{ $theme.syntax_cyan }}{{ else }}{{ $theme.cyan_bright }}{{ end }}",
}
