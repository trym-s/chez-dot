[Unit]
Description=Bisync shared_local with Google Drive Cloud folder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p %h/mnt/personal/shared_local
ExecStartPre=/usr/bin/bash -c 'for f in %h/.cache/rclone/bisync/*shared_local*.lck; do [ -f "$$f" ] || continue; pid=$$(grep -oP "\\d+" "$$f" 2>/dev/null | head -1); ( [ -n "$$pid" ] && kill -0 "$$pid" 2>/dev/null ) || rm -f "$$f"; done'
ExecStart=/usr/bin/flock -n %t/rclone-gcloud-bisync-shared-local.lock /usr/bin/rclone bisync %h/mnt/personal/shared_local gcloud:Cloud --create-empty-src-dirs --resilient --recover --filters-file %h/.config/rclone/bisync-shared-local-filters.txt
